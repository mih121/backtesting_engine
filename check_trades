# provera conBE :

def conBE(otr, st):
    res_b = False
    res_s = False

    dtype = [
        ('action', 'U4'),
        ('magic_number', 'i8'),
        ('open_time', 'datetime64[s]'),
    ]

    data = np.array([
        (
            trade['action'],
            trade['magic_number'],
            np.datetime64(trade['open_time'])  # works if it's str or datetime
        )
        for trade in otr
    ], dtype=dtype)

    st_np = np.datetime64(st)

    # --- BUY SIDE ---
    buy_mask = data['action'] == "buy"
    buy_data = data[buy_mask]
    buy_pos_in_data = np.nonzero(buy_mask)[0]

    if buy_data.size > 0:
        order_desc = np.argsort(buy_data['open_time'])[::-1]
        buy_indices = buy_pos_in_data[order_desc]
        first_two_indices = buy_indices[:2]

        magicLast           = data['magic_number'][first_two_indices[0]]
        last_buy_open_time  = data['open_time'][first_two_indices[0]]

        # FIXED: use == / in, not "is" and bare magic number
        if magicLast in (magic7778, magic7701, magic7771) and last_buy_open_time >= st_np:
            res_b = True

    # --- SELL SIDE ---
    sell_mask = data['action'] == "sell"
    sell_data = data[sell_mask]
    sell_pos_in_data = np.nonzero(sell_mask)[0]

    if sell_data.size > 0:
        order_desc = np.argsort(sell_data['open_time'])[::-1]
        sell_indices = sell_pos_in_data[order_desc]
        first_two_indices_s = sell_indices[:2]

        magicLast           = data['magic_number'][first_two_indices_s[0]]
        last_sell_open_time = data['open_time'][first_two_indices_s[0]]

        # FIXED: same here
        if magicLast in (magic8889, magic8801, magic8881) and last_sell_open_time >= st_np:
            res_s = True

    return res_b, res_s
