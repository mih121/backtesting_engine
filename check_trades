def get_order_by_ref(self, ref):
    """Get the order by its reference."""
    for o in self.broker.orders:
        if o.ref == ref:
            return o
    return None

def parse_datetime(dt_str):
    if not dt_str:
        return None
    try:
        return datetime.strptime(dt_str, "%Y-%m-%d %H:%M:%S%z").replace(tzinfo=None)
    except ValueError:
        return datetime.strptime(dt_str, "%Y-%m-%d %H:%M:%S")


def convert_to_datetime(ordinal_timestamp):
    """
    Converts an ordinal timestamp, ISO-formatted string, or datetime object into a datetime object.

    Args:
        ordinal_timestamp (int, str, datetime): The input timestamp.

    Returns:
        datetime: A datetime object, or None if the input is invalid.
    """
    try:
        # Case 1: Input is already a datetime object
        if isinstance(ordinal_timestamp, datetime):
            return ordinal_timestamp
        
        # Case 2: Input is a string in ISO format
        if isinstance(ordinal_timestamp, str):
            return datetime.fromisoformat(ordinal_timestamp)  # Handles timezone-aware strings
        
        # Case 3: Input is an ordinal timestamp (integer or float)
        if isinstance(ordinal_timestamp, float):
            if not math.isfinite(ordinal_timestamp):
                print(f"Warning: Invalid ordinal timestamp ({ordinal_timestamp}) ignored.")
                return None
            ordinal_timestamp = int(ordinal_timestamp)  # Truncate decimals
        
        if not isinstance(ordinal_timestamp, int):
            raise ValueError("Ordinal timestamp must be an integer.")
        
        if ordinal_timestamp < 1 or ordinal_timestamp > 1_000_000:  # Arbitrary upper limit
            raise ValueError("Ordinal timestamp is out of range.")
        
        base_date = datetime(1, 1, 1)  # Python ordinal base date
        return base_date + timedelta(days=ordinal_timestamp - 1)  # Adjust for inclusive counting
    
    except (ValueError, OverflowError) as e:
        print(f"Warning: Invalid ordinal timestamp: {ordinal_timestamp}. Error: {e}")
        return None

