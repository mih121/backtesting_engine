def lowest_price_order_np_batch(c_p, prices, open_times, cb, ct, m1_index):
    data = CandleData2(c_p)
    timeframeM1 = "M1"
    candle_df = data.get_candles_bulk(timeframeM1, start=m1_index, end=0)  # pandas DataFrame

    # Convert open_time strings to naive datetimes
    open_times_dt = np.array([parse_datetime(t) for t in open_times])

    # Compare ct < open_times for all elements (vectorized)
    ct_array = np.full(open_times_dt.shape, ct)
    ct_mask = ct_array < open_times_dt
    # If ct < open_time, return False for that element
    results = np.full(len(prices), False, dtype=bool)
    results[ct_mask] = False  # early False

    # For each valid index, check candles after open_time
    # Unfortunately, filtering candles per open_time is still tricky vectorized.
    # Instead, for efficiency, you can iterate only over valid indexes:
    valid_indexes = np.where(~ct_mask)[0]

    # Step 1: Convert to datetime with timezone (UTC)
    candle_df['Datetime'] = pd.to_datetime(candle_df['Datetime'], utc=True)

    candle_df['Datetime'] = candle_df['Datetime'].dt.tz_convert('UTC')  # they were tz‑aware already

    open_times_dt = pd.to_datetime(open_times, format="%Y-%m-%d %H:%M:%S", utc=True)

    for i in valid_indexes:
        open_time = open_times_dt[i]
        price = prices[i]

        valid_candles = candle_df[candle_df['Datetime'] >= open_time]
        if valid_candles.empty:
            results[i] = False
        else:
            results[i] = (valid_candles['Low'] >= price).all()

    return results

