def zadnjiB_S_dt_cena(trade_log, st):
    """
    Returns:
      (buy_dt, buy_price), (sell_dt, sell_price)
    for the latest BUY and SELL with:
      - open_time ≥ st
      - magic not in their respective exclusion sets
    Stops as soon as it has both.
    """
    buy_exclude  = {magic4477, magic7002, magic7070} #??? , magic7771}
    sell_exclude = {magic4477, magic8002, magic8080} #??? , magic8881}

    buy_res  = (None, None)
    sell_res = (None, None)
    st_dt = st if not isinstance(st, str) else datetime.strptime(st, "%Y-%m-%d %H:%M:%S%z").replace(tzinfo=None)

    for trade in reversed(trade_log):
        ot = trade['open_time']
        open_dt = (ot if not isinstance(ot, str)
                   else datetime.strptime(ot, "%Y-%m-%d %H:%M:%S%z").replace(tzinfo=None))

        if open_dt < st_dt:
            continue

        mag = trade['magic_number']
        price = trade['open_price']

        if trade['action'] == 'buy' and buy_res[0] is None:
            if mag not in buy_exclude:
                buy_res = (open_dt, price)

        elif trade['action'] == 'sell' and sell_res[0] is None:
            if mag not in sell_exclude:
                sell_res = (open_dt, price)

        # once both found, break
        if buy_res[0] and sell_res[0]:
            break

    return buy_res, sell_res


