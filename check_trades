class OrderTracker:
    def __init__(self):

        self.indexes = {
            "M1": 0, "M15": 0, "M30": 0, "H1": 0, "H4": 0, "D1": 0
        }

    def currIndex(self, timeframe):
        # Increase index based on timeframe logic
        if timeframe == "M1":
            self.indexes["M1"] += 1
            
            # Now update the other timeframes based on the current state of "M1"
            if self.indexes["M1"] % 15 == 0:
                self.indexes["M15"] += 1
            if self.indexes["M1"] % 30 == 0:
                self.indexes["M30"] += 1
            if self.indexes["M1"] % 60 == 0:
                self.indexes["H1"] += 1
            #if self.indexes["M1"] % 240 == 0:
            #   self.indexes["H4"] += 1
            # ZATO STO TVOJI POCINJU OD 21 UMESTO OD 22H KOD H4 MORA OVAKO
            if self.indexes["M1"] % 240 == 0:
                self.indexes["H4"] += 1
            if self.indexes["M1"] % 960 == 0:
                self.indexes["D1"] += 1

        return self.indexes[timeframe]

class OrderTracker2:
    __slots__ = ("m1","m15","m30","h1","h4","d1")

    def __init__(self):
        # all start at zero
        self.m1 = self.m15 = self.m30 = self.h1 = self.h4 = self.d1 = 0

    def tick(self):
        """
        Call this exactly once per M1bar. Returns the new M1 index.
        Other TFs are updated internally.
        """
        m1 = self.m1 + 1
        self.m1 = m1

        # inline modulus checks
        if m1 % 15   == 0: self.m15 += 1
        if m1 % 30   == 0: self.m30 += 1
        if m1 % 60   == 0: self.h1  += 1
        # special H4 offset at 180 then every 240
        if m1 >= 180 and (m1 - 180) % 240 == 0:
            self.h4 += 1
        if m1 % 960  == 0: self.d1  += 1

        return m1


