        Returns:
          (buy_time, buy_price), (sell_time, sell_price)
        for the **latest** BUY and SELL that:
          - open_time ≥ st
          - open_time ≤ ct
          - never dipped below/above SL on M1
          - magic passes isOMN_B / isOMN_S
        """
        buy_res  = (None, None)
        sell_res = (None, None)

        if not open_orders:
            return buy_res, sell_res

        # parse once
        st_dt = (
            datetime.strptime(st, "%Y-%m-%d %H:%M:%S%z")
            .replace(tzinfo=None) if isinstance(st, str) else st
        )
        ct_dt = (
            datetime.strptime(ct, "%Y-%m-%d %H:%M:%S%z")
            .replace(tzinfo=None) if isinstance(ct, str) else ct
        )

