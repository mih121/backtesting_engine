            open_dt = (
                datetime.strptime(ot, "%Y-%m-%d %H:%M:%S%z")
                .replace(tzinfo=None) if isinstance(ot, str) else ot
            )
            if not (st_dt <= open_dt <= ct_dt):
                continue

            magic = trade['magic_number']

            if trade['action'] == 'buy' and buy_res[0] is None:
                # must be in‐bounds and isOMN_B
                if isOMN_B(magic):
                    buy_res = (open_dt, trade['open_price'])

            elif trade['action'] == 'sell' and sell_res[0] is None:
                if isOMN_S(magic):
                    sell_res = (open_dt, trade['open_price'])

            # once we have both, we can stop
            if (buy_res[0] is not None) or (sell_res[0] is not None):
                break

        return buy_res, sell_res
    
