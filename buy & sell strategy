class sellStrategy:

    def __init__(self, data, shared, parent): #, offsets, percents, risk_reward):
        #self.order_tracker = OrderTracker()  # Create instance of OrderTracker
        self.order_tracker = OrderTracker() #create_order_tracker

        self.order_magic_map = {} 

        self.data = data
        self.parent = parent
        self.shared = shared # sharedState()
        
        self.hit_levels_b = defaultdict(set) 
        self.hit_levels_s = defaultdict(set) 
    
    def sell_order(self, ct, cb, volume, con13, magic):
        """Place a sell order with parameters and log trade using Trade class."""
        magic_number = magic #self.params_sell['magic_number']
            
        manMagic = magic == checkTrades.magic8881
        specCon = magic == checkTrades.magic8008
        stop_loss, scenario = None, 25

        stop_loss = self.shared.params_sell["stop_loss_25"]
        
        take_profit = self.shared.params_sell['take_profit']

        stop_loss_price = cb + stop_loss  # Stop loss price
        take_profit_price = cb - take_profit  # Take profit price

        # Place the sell order and get the reference
        order = self.parent.sell(size=volume, exectype=bt.Order.Market)

        # Create a Trade object for the sell order
        trade = bt.trade.Trade(
            data=self.data,  # Data feed
            tradeid=order.ref,  # Use the order reference as trade ID
            historyon=True,  # Enable history tracking
            size=-volume,  # Size for sell (negative value)
            price=cb,  # Price at which the trade was opened
            value=cb * volume,  # Value of the trade
            commission=0.01  # Example commission
        )

        # inside sell_order() before appending to shared arrays
        open_px = float(cb)                                # entry price
        sl_px   = float(stop_loss_price)   if stop_loss_price is not None else None
        tp_px   = float(take_profit_price) if take_profit_price is not None else None

        # freeze initial risk unit (independent of later BE SL-move)
        if sl_px is not None:
            ru = abs(open_px - sl_px)
        else:
            ru = stop_loss                    # fallback to your param

        if ru <= 0:
            ru = stop_loss                    # guard (or tiny epsilon)

        trade_info = dict(
            scenario=float(scenario),
            action="sell",
            lot_size=float(volume),
            open_price=open_px,
            close_price=float(0.0),
            open_time=ct,
            close_time=datetime.min,
            stop_loss=sl_px,
            take_profit=tp_px,
            closed_size=0.0,
            break_even=False,
            current_rr=0.0,
            levels_hit=set(),
            max_price=0.0,
            min_price=0.0,
            magic_number=magic,
            risk_reward=0.0,
            profit=0.0
        )

        self.shared.trade_log.append(trade_info)
        self.shared.open_trades.append(trade_info)

        print(f"\n Sell Order Placed at {cb}: Lot Size: {volume}, Stop Loss: {stop_loss}, \
              Take Profit: {take_profit}, Magic: {magic_number}")
        return order
    
    def buy_close(self, volume):
        # Sell to close buy position
        order = self.parent.sell(size=volume, exectype=bt.Order.Market)
        return order
    
    def sell_close(self, volume):
        # Buy to close sell position
        order = self.parent.buy(size=volume, exectype=bt.Order.Market)
        return order

