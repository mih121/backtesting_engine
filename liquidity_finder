def to_scalar(thr):
    # turn numpy arrays into a single float, or None if empty
    if isinstance(thr, np.ndarray):
        return None if thr.size == 0 else float(thr.flat[0])
    # if it’s already a float (or int), just cast
    try:
        return float(thr)
    except:
        return None

class LiquidityScanner:
    """
    Same as before, but now we only build zones when file1.function1(tf, q) == True.
    """
    tfH1, tfH4, tfD1 = "H1", "H4", "D1"
    PERIOD_MINUTES   = {tfH1: 60, tfH4: 240, tfD1: 1440}

    def __init__(self, csv_paths):
        import os

        cache_dir = "cache"
        os.makedirs(cache_dir, exist_ok=True)
        #cache_file = os.path.join(cache_dir, "liqudity_H1H4D1_station_mar24.npz")

        cache_file = os.path.join(cache_dir, f"liqudity_H1H4D1_station_{MONTH_TAG}.npz")

        # 0) try to load from cache
        if os.path.exists(cache_file):
            data = np.load(cache_file, allow_pickle=True)

            self.m1_lows   = data["m1_lows"]
            self.m1_highs  = data["m1_highs"]
            self.m1_times  = data["m1_times"]
            self.h1_times  = data["h1_times"]
            self.h4_times  = data["h4_times"]
            self.d1_times  = data["d1_times"]

            self.zones     = data["zones"]
            self.zones_s   = data["zones_s"]
            self.idx1      = data["idx1"]
            self.idx1_s    = data["idx1_s"]

            print("cache: B: Built zones LIQ _ H1/H4 (tf, q, p1, side, close_time):")
            for tf, q, p1, p2, open_time, close_time in self.zones:
                ct_str = np.datetime_as_string(close_time, unit='s')
                print(f"{tf:>3} | q={q:4d} | p1={p1:8.4f} | open_time={open_time:>4s} | close_time={ct_str}")

            print("cache: S: Built zones LIQ _ H1/H4 (tf, q, p1_s, side, close_time):")
            for tf, q, p1_s, p2_s, open_time, close_time in self.zones_s:
                ct_str = np.datetime_as_string(close_time, unit='s')
                print(f"{tf:>3} | q={q:4d} | p1_s={p1_s:8.4f} | open_time={open_time:>4s} | close_time={ct_str}")

            return

        # 1) raw M1 lows & times (slow path – first build)
        cd = CandleData2(csv_paths)

        m1             = cd.data['M1']
        self.m1_lows   = np.array(m1['Low'],      dtype=float)
        self.m1_highs  = np.array(m1['High'],     dtype=float)
        self.m1_times  = np.array(m1['Datetime'], dtype='datetime64[s]')

        self.h1_times  = np.array(cd.data[self.tfH1]['Datetime'],  dtype='datetime64[s]')
        self.h4_times  = np.array(cd.data[self.tfH4]['Datetime'],  dtype='datetime64[s]')
        self.d1_times  = np.array(cd.data[self.tfD1]['Datetime'],  dtype='datetime64[s]')

        # 2) build zones only when file1.function1 says so
        recs_b = []
        recs_s = []

        for tf, dur in self.PERIOD_MINUTES.items():
            lows   = np.array(cd.data[tf]['Low'],      dtype=float)
            highs  = np.array(cd.data[tf]['High'],     dtype=float)
            times  = np.array(cd.data[tf]['Datetime'], dtype='datetime64[s]')
            raz    = RAZMAKS[tf]
            raz_ic = RAZMAKICS[tf]

            for q, (lw, t0) in enumerate(zip(lows, times)):
                if not conditionsForLiq.liq_B(csv_paths, tf, q):
                    continue

                open_time  = t0
                close_time = t0 + np.timedelta64(self.PERIOD_MINUTES[tf], 'm')
                p1 = lw - raz_ic
                p2 = lw - raz

                recs_b.append((tf, q, p1, p2, open_time, close_time))

            for q, (hih, t0) in enumerate(zip(highs, times)):
                if not conditionsForLiq.liq_S(csv_paths, tf, q):
                    continue

                open_time  = t0
                close_time = t0 + np.timedelta64(self.PERIOD_MINUTES[tf], 'm')
                p1 = hih + raz_ic
                p2 = hih + raz

                recs_s.append((tf, q, p1, p2, open_time, close_time))

        dtype = [
            ('tf',        'U3'),
            ('q',         'i4'),
            ('p1',        'f8'),
            ('p2',        'f8'),
            ('open_time','datetime64[s]'),
            ('close_time','datetime64[s]'),
        ]
        self.zones   = np.array(recs_b,   dtype=dtype)
        self.zones_s = np.array(recs_s, dtype=dtype)

        self.zones   = np.sort(self.zones,   order='close_time')[::-1]
        self.zones_s = np.sort(self.zones_s, order='close_time')[::-1]

        # 3) precompute the M1-indices of each zone’s close
        self.idx1   = np.searchsorted(self.m1_times, self.zones['close_time'])
        self.idx1_s = np.searchsorted(self.m1_times, self.zones_s['close_time'])

        # save to cache
        np.savez_compressed(
            cache_file,
            m1_lows=self.m1_lows,
            m1_highs=self.m1_highs,
            m1_times=self.m1_times,
            h1_times=self.h1_times,
            h4_times=self.h4_times,
            d1_times=self.d1_times,
            zones=self.zones,
            zones_s=self.zones_s,
            idx1=self.idx1,
            idx1_s=self.idx1_s,
        )

        print("cache: B: Built zones LIQ _ H1/H4 (tf, q, p1, side, close_time):")
        for tf, q, p1, p2, open_time, close_time in self.zones:
            ct_str = np.datetime_as_string(close_time, unit='s')
            print(f"{tf:>3} | q={q:4d} | p1={p1:8.4f} | open_time={open_time:>4s} | close_time={ct_str}")

        print("cache: S: Built zones LIQ _ H1/H4 (tf, q, p1_s, side, close_time):")
        for tf, q, p1_s, p2_s, open_time, close_time in self.zones_s:
            ct_str = np.datetime_as_string(close_time, unit='s')
            print(f"{tf:>3} | q={q:4d} | p1_s={p1_s:8.4f} | open_time={open_time:>4s} | close_time={ct_str}")

