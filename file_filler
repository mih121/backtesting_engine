# Helpers to avoid re-downloading if files exist
# ─────────────────────────────────────────
def _expected_csv_paths(base_dir: str, prefix: str) -> dict[str, str]:
    return {
        "M1":  os.path.join(base_dir, f"{prefix}_M1.csv"),
        "M15": os.path.join(base_dir, f"{prefix}_M15.csv"),
        "M30": os.path.join(base_dir, f"{prefix}_M30.csv"),
        "H1":  os.path.join(base_dir, f"{prefix}_H1.csv"),
        "H4":  os.path.join(base_dir, f"{prefix}_H4.csv"),
        "D1":  os.path.join(base_dir, f"{prefix}_D1.csv"),
    }


def _csv_ok(p: str, min_bytes: int = 50) -> bool:
    return os.path.exists(p) and os.path.getsize(p) >= min_bytes

def get_csv_paths() -> dict[str, str]:
    paths = _expected_csv_paths(BASE_DIR, PREFIX)
    all_ok = all(_csv_ok(p) for p in paths.values())

    if all_ok:
        return paths

    # optional: delete bad/empty files so you don't reuse them
    for p in paths.values():
        if os.path.exists(p) and os.path.getsize(p) == 0:
            os.remove(p)

    return build_multi_tf_csvs(
        symbol="C:EURUSD",
        start_date=from_date,
        end_date=to_date,
        base_dir=BASE_DIR,
        prefix=PREFIX,
    )


