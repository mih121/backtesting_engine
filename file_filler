# ─────────────────────────────────────────
# Fill gaps in M1 (make 1-minute series continuous)
# ─────────────────────────────────────────
def fill_m1_gaps_file(path: str, max_gap_minutes: int = 5):
    """
    Load M1 CSV at `path`, fill only small gaps (<= max_gap_minutes)
    unutar pojedinačnih sesija i overwrite-uje fajl.

    - Datetime: ostaje u formatu '%Y-%m-%d %H:%M:%S%z'
    - OHLC na sintetičkim barovima: prethodni Close
    - Volume na sintetičkim barovima: 0
    - Veliki gapovi (vikendi, > max_gap_minutes) se NE popunjavaju
    """
    if not os.path.exists(path):
        raise FileNotFoundError(f"M1 file not found: {path}")

    df = pd.read_csv(path)

    # očekujemo: Datetime, Open, High, Low, Close, Volume
    df["Datetime"] = pd.to_datetime(df["Datetime"], format=DATE_FORMAT, utc=True)
    df = df.sort_values("Datetime")

    # izračunaj razlike između redova
    df["diff"] = df["Datetime"].diff()
    max_gap = pd.Timedelta(minutes=max_gap_minutes)

    # novi "session" počinje kad je diff > max_gap (vikendi, noć, itd.)
    df["session"] = (df["diff"] > max_gap).cumsum()

    filled_sessions = []

    for _, g in df.groupby("session"):
        g = g.drop(columns=["diff", "session"])

        # unutar jedne sesije pravimo full 1-min grid
        full_index = pd.date_range(
            start=g["Datetime"].iloc[0],
            end=g["Datetime"].iloc[-1],
            freq="1min",
            tz="UTC",
        )

        g2 = g.set_index("Datetime").reindex(full_index)

        # koje su bile rupe
        is_gap = g2["Close"].isna()

        # ffill svega
        g2_ff = g2.ffill()

        # OHLC iz prethodnog Close
        prev_close = g2_ff["Close"]
        for col in ["Open", "High", "Low", "Close"]:
            if col in g2_ff.columns:
                g2_ff.loc[is_gap, col] = prev_close[is_gap]

        # Volume = 0 na gapovima
        if "Volume" in g2_ff.columns:
            g2_ff.loc[is_gap, "Volume"] = 0

        g2_ff = g2_ff.reset_index().rename(columns={"index": "Datetime"})
        filled_sessions.append(g2_ff)

    df_ff = pd.concat(filled_sessions, ignore_index=True)

    # vrati Datetime u string format kao u originalu
    df_ff["Datetime"] = df_ff["Datetime"].dt.strftime(DATE_FORMAT)

    df_ff.to_csv(path, index=False)


