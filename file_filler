# --- LIVE: build a DataFrame from FIX candles (same columns as CSV) ---

def candles_np_to_dataframe(candles: np.ndarray) -> pd.DataFrame:
    """
    Convert QuoteFixApp.get_candles_np(...) output to the same
    DataFrame structure as load_dataframe(...) from CSV.
    """
    if candles.size == 0:
        return pd.DataFrame(columns=["Datetime", "Open", "High", "Low", "Close", "Volume"])

    df = pd.DataFrame({
        "Datetime": candles["open_time"].astype("datetime64[s]"),
        "Open":     candles["open"],
        "High":     candles["high"],
        "Low":      candles["low"],
        "Close":    candles["close"],
        "Volume":   candles["volume"],
    })

    # match old behaviour: drop tz (we store UTC anyway)
    df["Datetime"] = pd.to_datetime(df["Datetime"], utc=True)
    df["Datetime"] = df["Datetime"].dt.tz_localize(None)

    return df


def load_dataframe(tf: str) -> pd.DataFrame:
    """
    Load CSV for the given timeframe into a pandas DataFrame,
    parse tz-aware datetimes, then drop timezone info for NumPy compatibility.
    """
    path = CSV_PATHS[tf]
    df = pd.read_csv(path)
    df['Datetime'] = pd.to_datetime(df['Datetime'], format=DATE_FORMAT, utc=True)
    df['Datetime'] = df['Datetime'].dt.tz_localize(None)
    return df


# map your label -> seconds (must match TIMEFRAMES_SEC in FIX app)
TF_TO_SEC = {
    "M1": 60,
    "M15": 900,
    "M30": 1800,
    "H1": 3600,
    "H4": 14400,
    "D1": 86400,
}

def load_live_dataframe(tf: str, quote_app) -> pd.DataFrame:
    """
    Use FIX live candles instead of CSV.
    Call this only when is_new_candle(...) is True for that TF.
    """
    tf_sec = TF_TO_SEC[tf]
    candles = quote_app.get_candles_np(tf_sec, include_current=False)
    return candles_np_to_dataframe(candles)
